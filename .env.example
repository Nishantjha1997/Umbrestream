# TMDB "API Read Access Token" — the long JWT from
# https://www.themoviedb.org/settings/api (NOT the short v3 API key).
#
# No NEXT_PUBLIC_ prefix. Anything with that prefix is inlined into the client
# bundle and shipped to every visitor.
TMDB_READ_TOKEN=

# Optional. Point the reference "direct" source adapter at a JSON manifest of
# your own files. See src/lib/sources/README.md.
# DIRECT_LIBRARY_MANIFEST=./library.json
