# Server environment variables
PROTECTED_PATHS="/auth/reset-password,/profile" #OPTIONAL, comma separated list of protected paths
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key #REQUIRED
PLAYER_DIRECT_SOURCES_JSON= #OPTIONAL, authorized HLS/DASH/MP4 entries as JSON
PLAYER_SUBTITLE_HOSTS= #OPTIONAL, comma-separated HTTPS hosts for direct-source SRT/VTT tracks

# Anime API sources (self-hosted required — Vercel IPs are blocked by streaming providers)
# Self-host Anivexa API: https://github.com/walterwhite-69/Anivexa-API
ANIVEXA_API_BASE_URL= #OPTIONAL, e.g. https://your-anivexa.railway.app
# Self-host MiruroAPI: https://github.com/miruro-official/miruro-api
MIRURO_API_BASE_URL= #OPTIONAL, e.g. https://your-miruro.railway.app
# Required when either API above is set — comma-separated list of their HTTPS origins
STREAMFREE_ANIME_ALLOWED_ORIGINS= #e.g. https://your-anivexa.railway.app,https://your-miruro.railway.app

# Client environment variables
NEXT_PUBLIC_TMDB_ACCESS_TOKEN="your_tmdb_access_token" #REQUIRED, not the api key
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url #REQUIRED
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key #REQUIRED
NEXT_PUBLIC_CAPTCHA_SITE_KEY=your_captcha_site_key #OPTIONAL, if you want to use captcha
NEXT_PUBLIC_AVATAR_PROVIDER_URL=your_avatar_provider_url #OPTIONAL, avatar for your users
NEXT_PUBLIC_PLAYER_ENGINE_V2=true #OPTIONAL, V2 is on by default; set false for one-click rollback
NEXT_PUBLIC_PLAYER_ENGINE_V3=true #OPTIONAL, fast-start hybrid engine; set false to use V2 preflight
NEXT_PUBLIC_ANIME_SOURCES_V2=true #OPTIONAL, AniLink + VidNest AnimePahe recovery; set false for rollback
NEXT_PUBLIC_UMBRA_UI_V2=true #OPTIONAL, immersive dark shell; set false for rollback
