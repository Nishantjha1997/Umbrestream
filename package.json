{
  "name": "umbra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:player-sources": "node --experimental-strip-types scripts/check-player-sources.mjs",
    "test:episode-resolver": "node --experimental-strip-types scripts/check-episode-resolver.mjs",
    "test:continue-watching": "node --experimental-strip-types scripts/check-continue-watching.mjs",
    "test:home-feed": "node --experimental-strip-types scripts/check-home-feed.mjs",
    "test:anime-integrations": "node --experimental-strip-types scripts/check-anime-integrations.mjs",
    "test:native-cache": "node --experimental-strip-types scripts/check-native-cache.mjs",
    "test:native-history": "node --experimental-strip-types scripts/check-native-history.mjs",
    "test:native-update-state": "node --experimental-strip-types scripts/check-native-update-state.mjs",
    "check:release-artifacts": "node scripts/check-release-artifacts.mjs",
    "test:update-manifests": "node scripts/check-update-manifests.mjs",
    "check:leak": "node scripts/check-leak.mjs",
    "mobile:build": "esbuild mobile/app.js --bundle --format=iife --platform=browser --target=chrome120 --minify --outfile=mobile/app.bundle.js",
    "tv:build": "esbuild tv/app.js --bundle --format=iife --platform=browser --target=chrome100 --minify --outfile=tv/app.bundle.js",
    "android:sync": "npm run mobile:build && cap sync android",
    "android:apk:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:apk:release": "npm run android:sync && cd android && gradlew.bat assembleRelease",
    "android:apk": "npm run android:apk:release",
    "android-tv:sync": "npm run tv:build && node scripts/sync-tv-assets.mjs",
    "android-tv:apk:debug": "npm run android-tv:sync && cd android-tv && gradlew.bat assembleDebug",
    "android-tv:apk:release": "npm run android-tv:sync && cd android-tv && gradlew.bat assembleRelease",
    "android-tv:apk": "npm run android-tv:apk:release",
    "verify": "npm run lint && npm run test:player-sources && npm run test:update-manifests && npm run typecheck && npm run build && npm run check:release-artifacts && npm run check:leak",
    "sb-start": "supabase start --debug --ignore-health-check",
    "sb-stop": "supabase stop --debug --all",
    "sb-restart": "supabase stop --debug --all && supabase start --debug --ignore-health-check",
    "sb-db-reset": "supabase db reset",
    "sb-db-types": "supabase gen types typescript --local > src/utils/supabase/types.ts"
  },
  "dependencies": {
    "@bprogress/next": "^3.2.12",
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@heroui/button": "2.2.25",
    "@heroui/chip": "2.2.21",
    "@heroui/image": "2.2.16",
    "@heroui/link": "2.2.22",
    "@heroui/react": "^2.8.3",
    "@heroui/spinner": "2.2.22",
    "@hookform/resolvers": "^5.2.1",
    "@mantine/hooks": "^8.2.4",
    "@marsidev/react-turnstile": "^1.3.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.56.0",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tanstack/react-query": "^5.85.3",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "clsx": "1.2.1",
    "dashjs": "^5.2.0",
    "date-fns": "^4.1.0",
    "embla-carousel": "8.6.0",
    "embla-carousel-react": "^8.6.0",
    "hls.js": "^1.6.17",
    "motion": "^12.42.2",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "nuqs": "^2.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.62.0",
    "react-icons": "^5.5.0",
    "react-intersection-observer": "^9.16.0",
    "react-share": "^5.2.2",
    "string-ts": "^2.2.1",
    "tailwind-merge": "3.3.1",
    "tailwind-variants": "3.1.0",
    "tailwindcss-motion": "^1.1.1",
    "tmdb-ts": "^2.0.2",
    "use-long-press": "^3.3.0",
    "vaul": "^1.1.2",
    "yet-another-react-lightbox": "^3.25.0",
    "zod": "^4.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@iconify/react": "^6.0.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@tanstack/react-query-devtools": "^5.85.3",
    "@types/node": "^20",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.33.0",
    "eslint-config-next": "16.2.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "supabase": "^2.109.1",
    "tailwindcss": "^4.1.12",
    "typescript": "^5",
    "webpack": "^5.101.2"
  },
  "prettier": {
    "proseWrap": "never",
    "printWidth": 100,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
